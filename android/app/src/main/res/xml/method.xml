<?xml version="1.0" encoding="utf-8"?>
<!-- supportsSwitchingToNextInputMethod lets Gboard's globe key cycle to Pogo and back. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="app.pogopaste.keyboard.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/subtype_label"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
